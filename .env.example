# Copia este archivo como .env y ajusta lo que necesites (SECRET_KEY es obligatoria para iniciar).
# MySQL persiste únicamente el catálogo maestro de partidas.
# Define una clave larga y privada antes de desplegar la aplicacion.
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=pega-aqui-una-clave-aleatoria-privada
# SESSION_COOKIE_SECURE=0 solo para desarrollo local por HTTP; en producción usa HTTPS y valor 1.
# SESSION_COOKIE_SECURE=1
# BIMETRICS_ENV=production activa validaciones para evitar arrancar en producción sin cookies seguras.
# Configura BIMETRICS_ENV=production solo detrás de un proxy HTTPS correctamente configurado.
# FLASK_DEBUG=1 únicamente para desarrollo local; por defecto el modo debug está apagado.
# CATALOG_DATABASE_URL=mysql+pymysql://usuario:clave@localhost/BIMetricsBD?charset=utf8mb4
# Alternativamente, configura MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD y MYSQL_DATABASE.
# La persistencia operativa de proyectos y presupuestos usa SQLite separado.
# OPERATIONAL_DATABASE_URL=sqlite:///data/presupuestos.db
# Para migrar datos anteriores: LEGACY_OPERATIONAL_DATABASE_URL=<URL SQL de origen>
# Frontend Vite (puede separar varios orígenes por comas)
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB guarda usuarios/perfiles y actividad BIM en bases separadas.
# En Atlas, conserva la URI completa en una sola linea y permite la IP de salida en Network Access.
# Opcional: usa resolutores DNS alternos si el DNS del sistema no resuelve mongodb+srv.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=bimetrics_users
# MONGO_ACTIVITY_DB_NAME=bimetrics_nosql
# Migración única de cuentas existentes: LEGACY_USERS_DATABASE_URL=<URL de la BD SQL anterior>
